# DataPilot AI Environment Configuration Example
# Copy this file to .env and provide your actual keys. Never commit real keys.

# --- Hosted Partner Model: TabPFN ---
# Create an API token at https://platform.priorlabs.ai/account/api-keys
# TabPFN client sends relevant tabular data to Prior Labs for hosted inference.
TABPFN_TOKEN=your_tabpfn_api_key_here

# --- AI Analyst Provider Configuration ---
# Supported providers: gemini (default), mock, deterministic
AI_PROVIDER=gemini

# Google Gemini API key from Google AI Studio (https://aistudio.google.com/)
AI_API_KEY=your_gemini_api_key_here

# Configurable Gemini model identifier (Flash-class recommended)
AI_MODEL=gemini-3.8-flash

# --- Application Privacy & Air-Gap Control ---
# When set to true, disables all external outbound AI calls (both TabPFN and Gemini)
# Local profiling, local baseline evaluations, and deterministic reports continue to work.
DATAPILOT_AIRGAP=false
